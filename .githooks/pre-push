#!/usr/bin/env bash
# Run the CI checks before the push leaves the machine. Two CI failures on main
# (both ruff I001) were pushes that would have been caught here.
#
# Enable once per clone:  make setup
# Bypass deliberately:    git push --no-verify
#
# Delegates to `make check` so the check list is defined once (Makefile) and
# mirrored only in .github/workflows/ci.yml.
set -euo pipefail

exec make check
